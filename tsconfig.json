{
  // The types of the JSDoc, checked by npm run typecheck: nothing is emitted, the page and the sync run these very files.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["site/**/*.js", "scripts/**/*.mjs", "tests/**/*.mjs", "types/*.d.ts"],
  "exclude": ["site/data"]
}
