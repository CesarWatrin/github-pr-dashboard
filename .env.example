# GitHub organization to track (required)
ORG=
# Token with read access to the organization pull requests (optional locally: falls back to `gh auth token`)
GITHUB_TOKEN=
# Password of the dashboard page, from which the key encrypting the published stats is derived (required).
# Use a long random value, for instance: node -e "console.log(require('crypto').randomBytes(20).toString('base64url'))"
DASHBOARD_PASSWORD=
# Repository types the languages misjudge, as repo:front|back|mobile|other separated by commas (optional)
REPO_CATEGORIES=
# User accounts of the organization acting as bots, logins separated by commas (optional)
BOT_USERS=
# Fine-grained token allowed to start the workflow of the dashboard repository, for the sync button (optional)
DISPATCH_TOKEN=
# owner/repo of the dashboard, needed with DISPATCH_TOKEN outside GitHub Actions
DISPATCH_REPOSITORY=
